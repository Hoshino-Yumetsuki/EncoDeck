<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EncoDeck.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EncoDeck.App.Controls"
    xmlns:services="using:EncoDeck.App.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Not the max-width element itself: a ScrollViewer centres its child by the child's desired width, which shifts it off-screen once the viewport is wider than the max width. -->
        <Grid>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="32,8,32,32" Spacing="16">

            <!-- App -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/EncoDeck-256.png" Width="72" Height="72" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="EncoDeck" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Uid="About_Tagline" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                                   Text="Manage your earbuds on Windows — no more reaching for your phone just to switch noise cancelling." />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,2,0,0">
                            <HyperlinkButton x:Uid="Settings_Source" Content="Source code" Padding="0" NavigateUri="https://github.com/TIANLI0/EncoDeck" />
                            <HyperlinkButton x:Uid="About_Compatibility" Content="Device compatibility" Padding="0" NavigateUri="https://github.com/TIANLI0/EncoDeck/blob/main/docs/COMPATIBILITY.md" />
                            <HyperlinkButton x:Uid="About_Changelog" Content="Changelog" Padding="0" NavigateUri="https://github.com/TIANLI0/EncoDeck/blob/main/CHANGELOG.md" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Updates (GitHub Releases); the Store build is updated by the Store -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind services:Ui.Visible(ViewModel.HasSelfUpdate)}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Settings_Updates" Text="Updates" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="{x:Bind ViewModel.CurrentVersionText}" Description="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Settings_CheckUpdates" Content="Check for updates" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                            <Button Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.UpdateActionText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RunUpdateActionCommand}" Visibility="{x:Bind services:Ui.Visible(ViewModel.IsUpdateActionVisible), Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingRow>
                    <ProgressBar Value="{x:Bind ViewModel.UpdateProgress, Mode=OneWay}" Visibility="{x:Bind services:Ui.Visible(ViewModel.IsUpdateDownloading), Mode=OneWay}" />
                    <StackPanel Spacing="4" Visibility="{x:Bind services:Ui.VisibleIfText(ViewModel.UpdateReleaseNotes), Mode=OneWay}">
                        <TextBlock x:Uid="Settings_StoreReleaseNotes" Text="What's new" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{x:Bind ViewModel.UpdateReleaseNotes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ScrollViewer>
                    </StackPanel>
                    <HyperlinkButton x:Uid="Settings_ReleaseNotes" Content="Release notes" Padding="0" NavigateUri="{x:Bind ViewModel.ReleaseNotesUrl, Mode=OneWay}"
                                     Visibility="{x:Bind services:Ui.Visible(ViewModel.HasReleaseNotes), Mode=OneWay}" />
                    <controls:SettingRow x:Uid="Settings_AutoUpdate" Header="Check for updates automatically"
                                         Description="Downloads new versions in the background and lets you know. Nothing is installed until you choose to.">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
                    </controls:SettingRow>
                    <controls:SettingRow x:Uid="Settings_Prerelease" Header="Receive preview versions" Description="Also offer pre-releases. They may be less stable.">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.IncludePrereleaseUpdates, Mode=TwoWay}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Updates through the Microsoft Store (MSIX build) -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind services:Ui.Collapsed(ViewModel.HasSelfUpdate)}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Settings_Updates" Text="Updates" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="{x:Bind ViewModel.CurrentVersionText}" Description="{x:Bind ViewModel.StoreUpdateStatus, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Settings_CheckUpdates" Content="Check for updates" Command="{x:Bind ViewModel.CheckStoreUpdatesCommand}" />
                            <Button x:Uid="Settings_StoreUpdate" Style="{StaticResource AccentButtonStyle}" Content="Update"
                                    Command="{x:Bind ViewModel.InstallStoreUpdateCommand}" Visibility="{x:Bind services:Ui.Visible(ViewModel.IsStoreUpdateAvailable), Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingRow>
                    <StackPanel Spacing="4" Visibility="{x:Bind services:Ui.VisibleIfText(ViewModel.StoreReleaseNotes), Mode=OneWay}">
                        <TextBlock x:Uid="Settings_StoreReleaseNotes" Text="What's new" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{x:Bind ViewModel.StoreReleaseNotes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ScrollViewer>
                    </StackPanel>
                    <controls:SettingRow x:Uid="Settings_StoreAutoUpdate" Header="Check for updates automatically"
                                         Description="Lets you know when a new version is available.">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Developer -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Settings_DeveloperLabel" Text="Developer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="44" Height="44" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="ms-appx:///Assets/Author.png" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tianli" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <HyperlinkButton Content="wutianli@tianli0.top" NavigateUri="mailto:wutianli@tianli0.top" Padding="0" />
                                <HyperlinkButton Content="GitHub · TIANLI0" NavigateUri="https://github.com/TIANLI0" Padding="0" />
                                <HyperlinkButton Content="tianli0.top" NavigateUri="https://tianli0.top" Padding="0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sponsor -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Uid="Settings_SponsorTitle" Text="Support the developer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="Settings_SponsorText" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                                   Text="EncoDeck is free and open source. If it helps you, consider sponsoring its development." />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEB51;" FontSize="14" />
                            <TextBlock x:Uid="Settings_SponsorButton" Text="Sponsor" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="Settings_SponsorTitle" Text="Support the developer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <StackPanel Spacing="4">
                                            <Image Source="ms-appx:///Assets/Support/alipay.png" Width="160" Height="240" Stretch="Uniform" />
                                            <TextBlock x:Uid="Settings_SponsorAlipay" Text="Alipay" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <Image Source="ms-appx:///Assets/Support/wechat.png" Width="176" Height="240" Stretch="Uniform" />
                                            <TextBlock x:Uid="Settings_SponsorWeChat" Text="WeChat Pay" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <!-- Feedback -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="About_Feedback" Text="Feedback" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="About_FeedbackText" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                                   Text="If the earbuds will not connect, a setting has no effect or the model is recognised wrongly, open an issue with the earbud model, firmware version, Windows version and the steps you took. Test results for models not yet verified are welcome too." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <HyperlinkButton x:Uid="About_ReportIssue" Content="Report an issue" Padding="0" NavigateUri="https://github.com/TIANLI0/EncoDeck/issues" />
                        <HyperlinkButton x:Uid="About_Contributing" Content="Contributing" Padding="0" NavigateUri="https://github.com/TIANLI0/EncoDeck/blob/main/CONTRIBUTING.md" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Acknowledgements (README) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="About_Thanks" Text="Acknowledgements" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="About_ThanksProtocol" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Text="Earbud protocol and device support" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <HyperlinkButton Content="OppoPodsWindows" Padding="0" NavigateUri="https://github.com/3295074384/OppoPodsWindows" />
                            <HyperlinkButton Content="OppoPodsManager" Padding="0" NavigateUri="https://github.com/Zhaoyi-ya/OppoPodsManager" />
                            <HyperlinkButton Content="OppoPods" Padding="0" NavigateUri="https://github.com/Leaf-lsgtky/OppoPods" />
                            <HyperlinkButton Content="HeyBuds" Padding="0" NavigateUri="https://github.com/abaichuan1017/HeyBuds" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="About_ThanksMoondrop" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Text="MOONDROP model data, GAIA framing and commands" />
                        <HyperlinkButton Content="MiuixMoondrop" Padding="0" NavigateUri="https://github.com/huime180/MiuixMoondrop" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="About_ThanksLhdc" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Text="LHDC V5 component" />
                        <HyperlinkButton Content="LHDC-Win" Padding="0" NavigateUri="https://github.com/Wayne-u/LHDC-Win" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="About_ThanksTray" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Text="Notification area icon" />
                        <HyperlinkButton Content="H.NotifyIcon" Padding="0" NavigateUri="https://github.com/HavenDV/H.NotifyIcon" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Legal -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="About_Legal" Text="Legal" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="Settings_Disclaimer" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                               Text="EncoDeck is an unofficial open-source project with no affiliation, partnership or endorsement from the earbud brands it supports or their manufacturers. Brand and product names are used only to describe compatibility." />
                    <TextBlock x:Uid="Settings_License" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                               Text="Licensed under the GNU General Public License v3.0 only (GPL-3.0-only). Third-party notices are included with the app." />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <HyperlinkButton x:Uid="Settings_Notices" Content="Third-party notices" Padding="0" Click="OnOpenNotices" />
                        <HyperlinkButton x:Uid="About_LicenseLink" Content="License" Padding="0" NavigateUri="https://github.com/TIANLI0/EncoDeck/blob/main/LICENSE" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

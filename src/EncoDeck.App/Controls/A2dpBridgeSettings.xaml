<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="EncoDeck.App.Controls.A2dpBridgeSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource CardStyle}">
  <StackPanel Spacing="10">
   <TextBlock x:Uid="Bridge_Title" Style="{StaticResource BodyStrongTextBlockStyle}" />
   <!-- Codecs, as the home page tags them; outlined ones are experimental upstream. -->
   <StackPanel Orientation="Horizontal" Spacing="6" x:Uid="Bridge_Codecs">
    <Border Style="{StaticResource CodecBadgeStyle}"><TextBlock Text="LDAC" Style="{StaticResource CodecBadgeTextStyle}" /></Border>
    <Border Style="{StaticResource CodecBadgeStyle}"><TextBlock Text="LHDC V5" Style="{StaticResource CodecBadgeTextStyle}" /></Border>
    <Border Style="{StaticResource CodecBadgeStyle}"><TextBlock Text="aptX" Style="{StaticResource CodecBadgeTextStyle}" /></Border>
    <Border Style="{StaticResource CodecBadgeStyle}"><TextBlock Text="AAC" Style="{StaticResource CodecBadgeTextStyle}" /></Border>
    <Border Style="{StaticResource CodecBadgeStyle}"><TextBlock Text="SBC XQ" Style="{StaticResource CodecBadgeTextStyle}" /></Border>
    <Border Style="{StaticResource CodecBadgeStyle}"><TextBlock Text="SBC" Style="{StaticResource CodecBadgeTextStyle}" /></Border>
    <Border Style="{StaticResource CodecBadgeSubtleStyle}" x:Uid="Codec_Experimental"><TextBlock Text="aptX HD" Style="{StaticResource CodecBadgeSubtleTextStyle}" /></Border>
    <Border Style="{StaticResource CodecBadgeSubtleStyle}" x:Uid="Codec_Experimental"><TextBlock Text="aptX LL" Style="{StaticResource CodecBadgeSubtleTextStyle}" /></Border>
    <Border Style="{StaticResource CodecBadgeSubtleStyle}" x:Uid="Codec_Experimental"><TextBlock Text="Opus" Style="{StaticResource CodecBadgeSubtleTextStyle}" /></Border>
   </StackPanel>
   <TextBlock x:Uid="Bridge_Summary" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
   <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" />
   <!-- A2DPWB's own installation updates and uninstalls itself. -->
   <StackPanel x:Name="OwnInstallNote" Spacing="2" Visibility="Collapsed">
    <TextBlock x:Uid="Bridge_OwnInstallNote" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
    <HyperlinkButton x:Uid="Bridge_OpenAppsSettings" NavigateUri="ms-settings:appsfeatures" Padding="0" />
   </StackPanel>
   <HyperlinkButton x:Name="StandaloneLink" x:Uid="Bridge_StandaloneLink" NavigateUri="https://github.com/TIANLI0/EncoDeck/releases/latest" Visibility="Collapsed" Padding="0" />
   <ProgressBar x:Name="Progress" Visibility="Collapsed" Maximum="100" />
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="Download" Click="OnDownload" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
    <Button x:Name="Cancel" Click="OnCancel" Visibility="Collapsed" />
    <Button x:Name="StartCore" Click="OnStartCore" Visibility="Collapsed" />
    <Button x:Name="QuitCore" Click="OnQuitCore" Visibility="Collapsed" />
    <Button x:Name="OpenWindow" Click="OnOpenWindow" Visibility="Collapsed" />
    <Button x:Name="CheckUpdates" Click="OnCheckUpdates" Visibility="Collapsed" />
    <Button x:Name="Uninstall" Click="OnUninstall" Visibility="Collapsed" />
   </StackPanel>

   <!-- While EncoDeck is connected to the core: adapter, stream, profiles and volume. -->
   <StackPanel x:Name="Live" Spacing="10" Visibility="Collapsed">
    <TextBlock x:Name="AdapterText" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
    <TextBlock x:Name="StreamText" TextWrapping="Wrap" />
    <Grid ColumnSpacing="8" x:Name="ProfileRow">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <ComboBox x:Name="Profiles" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="OnProfileChanged" />
     <Button x:Name="ConnectButton" Grid.Column="1" VerticalAlignment="Bottom" Click="OnConnect" />
     <Button x:Name="DisconnectButton" Grid.Column="2" VerticalAlignment="Bottom" Click="OnDisconnect" />
    </Grid>
    <TextBlock x:Name="NoProfiles" x:Uid="Bridge_NoProfiles" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
    <Slider x:Name="Volume" Minimum="0" Maximum="127" StepFrequency="1" Visibility="Collapsed" ValueChanged="OnVolumeChanged" />
    <!-- A new profile: EncoDeck's current earbuds (their address is known) or one found by a scan; the first connection pairs. -->
    <Expander x:Name="AddPanel" x:Uid="Bridge_Add" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
     <StackPanel Spacing="10">
      <TextBlock x:Uid="Bridge_AddNote" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <ComboBox x:Name="Candidates" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="OnCandidateChanged" />
       <Button x:Name="Scan" Grid.Column="1" VerticalAlignment="Bottom" Click="OnScan" />
      </Grid>
      <TextBlock x:Name="NoCandidates" x:Uid="Bridge_NoCandidates" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <ComboBox x:Name="Codec" HorizontalAlignment="Stretch" DisplayMemberPath="Label" />
       <Button x:Name="SaveProfile" Grid.Column="1" VerticalAlignment="Bottom" Click="OnSaveProfile" Style="{StaticResource AccentButtonStyle}" />
      </Grid>
     </StackPanel>
    </Expander>
   </StackPanel>

   <ToggleSwitch x:Name="AutoStart" x:Uid="Bridge_AutoStart" Toggled="OnAutoStartToggled" Visibility="Collapsed" />

   <Expander x:Name="AdaptersPanel" x:Uid="Bridge_Adapters" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
    <StackPanel Spacing="10">
     <TextBlock x:Uid="Bridge_AdaptersNote" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
     <StackPanel x:Name="AdapterList" Spacing="8" />
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="RefreshAdapters" Click="OnRefreshAdapters" />
      <Button x:Name="OpenSettingsFolder" Click="OnOpenSettingsFolder" />
      <HyperlinkButton x:Uid="Bridge_FirmwareLink" NavigateUri="https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git/tree/rtl_bt" />
     </StackPanel>
    </StackPanel>
   </Expander>

   <TextBlock x:Uid="Bridge_Disclaimer" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
   <Expander x:Uid="Bridge_Help" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="10">
     <TextBlock x:Uid="Bridge_HelpRequirements" TextWrapping="Wrap" />
     <TextBlock x:Uid="Bridge_HelpSetup" TextWrapping="Wrap" />
     <TextBlock x:Uid="Bridge_HelpDaily" TextWrapping="Wrap" />
     <TextBlock x:Uid="Bridge_HelpControls" TextWrapping="Wrap" />
     <TextBlock x:Uid="Bridge_HelpRestore" TextWrapping="Wrap" />
     <HyperlinkButton x:Uid="Bridge_Guide" NavigateUri="https://github.com/TIANLI0/EncoDeck/blob/main/docs/A2DP_BRIDGE.md" Padding="0" />
     <HyperlinkButton x:Uid="Bridge_Upstream" NavigateUri="https://github.com/SeiyaFunaokaJP/A2DP-Windows-Bridge" Padding="0" />
    </StackPanel>
   </Expander>
  </StackPanel>
 </Border>
</UserControl>

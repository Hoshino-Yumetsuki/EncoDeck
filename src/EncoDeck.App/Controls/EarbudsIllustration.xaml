<?xml version="1.0" encoding="utf-8"?>
<!-- Original generic earbuds-and-case illustration (EncoDeck artwork, GPL-3.0-only). -->
<UserControl
    x:Class="EncoDeck.App.Controls.EarbudsIllustration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw">
    <Viewbox Stretch="Uniform">
        <Canvas Width="240" Height="200">
            <!-- Charging case -->
            <Rectangle Canvas.Left="40" Canvas.Top="96" Width="160" Height="92" RadiusX="38" RadiusY="38"
                       Fill="{ThemeResource ControlFillColorDefaultBrush}"
                       Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="2" />
            <Line X1="44" Y1="122" X2="196" Y2="122" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1.5" Opacity="0.6" />
            <Ellipse Canvas.Left="114" Canvas.Top="164" Width="12" Height="6" Fill="{ThemeResource AccentFillColorDefaultBrush}" />

            <!-- Left bud -->
            <Canvas x:Name="LeftBud">
                <Canvas.RenderTransform>
                    <RotateTransform Angle="-14" CenterX="92" CenterY="70" />
                </Canvas.RenderTransform>
                <Rectangle Canvas.Left="86" Canvas.Top="52" Width="16" Height="66" RadiusX="8" RadiusY="8"
                           Fill="{ThemeResource ControlSolidFillColorDefaultBrush}"
                           Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="2" />
                <Ellipse Canvas.Left="70" Canvas.Top="18" Width="48" Height="44"
                         Fill="{ThemeResource ControlSolidFillColorDefaultBrush}"
                         Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="2" />
                <Ellipse Canvas.Left="96" Canvas.Top="30" Width="18" Height="18" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.85" />
            </Canvas>

            <!-- Right bud -->
            <Canvas x:Name="RightBud">
                <Canvas.RenderTransform>
                    <RotateTransform Angle="14" CenterX="148" CenterY="70" />
                </Canvas.RenderTransform>
                <Rectangle Canvas.Left="138" Canvas.Top="52" Width="16" Height="66" RadiusX="8" RadiusY="8"
                           Fill="{ThemeResource ControlSolidFillColorDefaultBrush}"
                           Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="2" />
                <Ellipse Canvas.Left="122" Canvas.Top="18" Width="48" Height="44"
                         Fill="{ThemeResource ControlSolidFillColorDefaultBrush}"
                         Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="2" />
                <Ellipse Canvas.Left="126" Canvas.Top="30" Width="18" Height="18" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.85" />
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>

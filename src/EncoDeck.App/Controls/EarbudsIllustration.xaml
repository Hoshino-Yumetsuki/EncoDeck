<?xml version="1.0" encoding="utf-8"?>
<!-- Original generic product illustrations (EncoDeck artwork, GPL-3.0-only): white earbuds with
     their case, and white headphones. Fixed product colours read well on light and dark themes. -->
<UserControl
    x:Class="EncoDeck.App.Controls.EarbudsIllustration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="0.55" Color="#F1F2F4" />
            <GradientStop Offset="1" Color="#D3D7DD" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CaseBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="0.6" Color="#EEF0F3" />
            <GradientStop Offset="1" Color="#CDD2D9" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="StemBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#E2E5EA" />
            <GradientStop Offset="0.35" Color="#FFFFFF" />
            <GradientStop Offset="1" Color="#C9CED6" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BandBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="1" Color="#D6DAE0" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="TipBrush" Center="0.4,0.4" GradientOrigin="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
            <GradientStop Offset="0" Color="#E9ECF0" />
            <GradientStop Offset="1" Color="#AEB5BF" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="CushionBrush" Center="0.45,0.4" GradientOrigin="0.45,0.4" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Offset="0" Color="#E4E7EB" />
            <GradientStop Offset="1" Color="#A9B0BA" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="ShadowBrush">
            <GradientStop Offset="0" Color="#38000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
        <SolidColorBrush x:Key="EdgeBrush" Color="#C3C8CF" />
        <SolidColorBrush x:Key="LedBrush" Color="#4CC38A" />
    </UserControl.Resources>
    <Grid>
        <Viewbox x:Name="Earbuds" Stretch="Uniform">
            <Canvas Width="240" Height="200">
                <Ellipse Canvas.Left="28" Canvas.Top="174" Width="184" Height="20" Fill="{StaticResource ShadowBrush}" />

                <!-- Case -->
                <Rectangle Canvas.Left="46" Canvas.Top="104" Width="148" Height="80" RadiusX="38" RadiusY="38"
                           Fill="{StaticResource CaseBrush}" Stroke="{StaticResource EdgeBrush}" StrokeThickness="0.8" />
                <Line X1="50" Y1="128" X2="190" Y2="128" Stroke="#B9BFC7" StrokeThickness="1.2" />
                <Path Data="M76,111 Q120,106 164,111" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9" />
                <Ellipse Canvas.Left="117.4" Canvas.Top="161.4" Width="5.2" Height="5.2" Fill="{StaticResource LedBrush}" />

                <!-- Left bud -->
                <Canvas>
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="-12" CenterX="92" CenterY="80" />
                    </Canvas.RenderTransform>
                    <Rectangle Canvas.Left="84" Canvas.Top="62" Width="17" Height="76" RadiusX="8.5" RadiusY="8.5"
                               Fill="{StaticResource StemBrush}" Stroke="{StaticResource EdgeBrush}" StrokeThickness="0.6" />
                    <Rectangle Canvas.Left="88" Canvas.Top="74" Width="3" Height="54" RadiusX="1.5" RadiusY="1.5" Fill="White" Opacity="0.9" />
                    <Ellipse Canvas.Left="62" Canvas.Top="42" Width="24" Height="28" Fill="{StaticResource TipBrush}" />
                    <Ellipse Canvas.Left="70" Canvas.Top="30" Width="44" Height="48"
                             Fill="{StaticResource ShellBrush}" Stroke="{StaticResource EdgeBrush}" StrokeThickness="0.6" />
                    <Ellipse Canvas.Left="79" Canvas.Top="40" Width="18" Height="12" Fill="White" Opacity="0.95" />
                    <Rectangle Canvas.Left="96" Canvas.Top="44" Width="5" Height="16" RadiusX="2.5" RadiusY="2.5" Fill="#BFC5CD" Opacity="0.7" />
                </Canvas>

                <!-- Right bud: the left one mirrored about the centre line -->
                <Canvas>
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="-12" CenterX="92" CenterY="80" />
                            <ScaleTransform ScaleX="-1" CenterX="120" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Rectangle Canvas.Left="84" Canvas.Top="62" Width="17" Height="76" RadiusX="8.5" RadiusY="8.5"
                               Fill="{StaticResource StemBrush}" Stroke="{StaticResource EdgeBrush}" StrokeThickness="0.6" />
                    <Rectangle Canvas.Left="88" Canvas.Top="74" Width="3" Height="54" RadiusX="1.5" RadiusY="1.5" Fill="White" Opacity="0.9" />
                    <Ellipse Canvas.Left="62" Canvas.Top="42" Width="24" Height="28" Fill="{StaticResource TipBrush}" />
                    <Ellipse Canvas.Left="70" Canvas.Top="30" Width="44" Height="48"
                             Fill="{StaticResource ShellBrush}" Stroke="{StaticResource EdgeBrush}" StrokeThickness="0.6" />
                    <Ellipse Canvas.Left="87" Canvas.Top="40" Width="18" Height="12" Fill="White" Opacity="0.95" />
                    <Rectangle Canvas.Left="96" Canvas.Top="44" Width="5" Height="16" RadiusX="2.5" RadiusY="2.5" Fill="#BFC5CD" Opacity="0.7" />
                </Canvas>
            </Canvas>
        </Viewbox>

        <Viewbox x:Name="Headphones" Stretch="Uniform" Visibility="Collapsed">
            <Canvas Width="240" Height="200">
                <Ellipse Canvas.Left="34" Canvas.Top="177" Width="172" Height="18" Fill="{StaticResource ShadowBrush}" />

                <!-- Headband -->
                <Path Data="M52,118 C52,40 188,40 188,118" Stroke="{StaticResource EdgeBrush}" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M52,118 C52,40 188,40 188,118" Stroke="{StaticResource BandBrush}" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M70,70 C90,46 150,46 170,70" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9" />
                <Rectangle Canvas.Left="44" Canvas.Top="104" Width="16" Height="26" RadiusX="6" RadiusY="6"
                           Fill="{StaticResource BandBrush}" Stroke="{StaticResource EdgeBrush}" StrokeThickness="0.6" />
                <Rectangle Canvas.Left="180" Canvas.Top="104" Width="16" Height="26" RadiusX="6" RadiusY="6"
                           Fill="{StaticResource BandBrush}" Stroke="{StaticResource EdgeBrush}" StrokeThickness="0.6" />

                <!-- Ear cups -->
                <Rectangle Canvas.Left="30" Canvas.Top="118" Width="44" Height="64" RadiusX="22" RadiusY="22"
                           Fill="{StaticResource ShellBrush}" Stroke="{StaticResource EdgeBrush}" StrokeThickness="0.6" />
                <Rectangle Canvas.Left="166" Canvas.Top="118" Width="44" Height="64" RadiusX="22" RadiusY="22"
                           Fill="{StaticResource ShellBrush}" Stroke="{StaticResource EdgeBrush}" StrokeThickness="0.6" />
                <Rectangle Canvas.Left="66" Canvas.Top="124" Width="12" Height="52" RadiusX="6" RadiusY="6" Fill="{StaticResource CushionBrush}" />
                <Rectangle Canvas.Left="162" Canvas.Top="124" Width="12" Height="52" RadiusX="6" RadiusY="6" Fill="{StaticResource CushionBrush}" />
                <Ellipse Canvas.Left="39" Canvas.Top="124" Width="14" Height="20" Fill="White" Opacity="0.95" />
                <Ellipse Canvas.Left="175" Canvas.Top="124" Width="14" Height="20" Fill="White" Opacity="0.95" />
                <Ellipse Canvas.Left="49.6" Canvas.Top="165.6" Width="4.8" Height="4.8" Fill="{StaticResource LedBrush}" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>

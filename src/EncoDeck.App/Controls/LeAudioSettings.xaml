<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="EncoDeck.App.Controls.LeAudioSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Visibility="Collapsed">
 <Border Style="{StaticResource CardStyle}">
  <StackPanel Spacing="10">
   <TextBlock x:Uid="LeAudio_Title" Style="{StaticResource BodyStrongTextBlockStyle}" />
   <TextBlock x:Uid="LeAudio_Summary" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
   <TextBlock x:Name="Status" TextWrapping="Wrap" />
   <TextBlock x:Name="Message" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
   <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="Switch" Click="OnSwitch" />
    <Button x:Name="Restore" Click="OnRestore" />
    <Button x:Name="Cancel" Click="OnCancel" Visibility="Collapsed" />
   </StackPanel>
   <TextBlock x:Uid="LeAudio_Disclaimer" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
   <Expander x:Uid="LeAudio_Help" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="10">
     <TextBlock x:Uid="LeAudio_HelpRequirements" TextWrapping="Wrap" />
     <TextBlock x:Uid="LeAudio_HelpSwitch" TextWrapping="Wrap" />
     <TextBlock x:Uid="LeAudio_HelpLimits" TextWrapping="Wrap" />
     <TextBlock x:Uid="LeAudio_HelpRestore" TextWrapping="Wrap" />
     <HyperlinkButton x:Uid="LeAudio_Guide" NavigateUri="https://github.com/TIANLI0/EncoDeck/blob/main/docs/LE_AUDIO.md" Padding="0" />
    </StackPanel>
   </Expander>
  </StackPanel>
 </Border>
</UserControl>

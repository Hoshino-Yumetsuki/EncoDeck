<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EncoDeck.App.Controls.ComponentIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">
    <Grid Width="22" Height="22">
        <!-- Earbud: a ring with L or R. -->
        <Grid x:Name="Bud">
            <Ellipse Stroke="{x:Bind Foreground, Mode=OneWay}" StrokeThickness="1.5" />
            <TextBlock x:Name="Letter"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,1"
                       FontSize="11"
                       FontWeight="SemiBold" />
        </Grid>
        <!-- Case: the pebble-shaped case with its lid seam. -->
        <Grid x:Name="Case" Height="17" VerticalAlignment="Center" Visibility="Collapsed">
            <Rectangle RadiusX="8.5" RadiusY="8.5" Stroke="{x:Bind Foreground, Mode=OneWay}" StrokeThickness="1.5" />
            <Rectangle Height="1.5" Margin="1,5,1,0" VerticalAlignment="Top" Fill="{x:Bind Foreground, Mode=OneWay}" />
            <Ellipse Width="3" Height="3" Margin="0,0,0,3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{x:Bind Foreground, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
